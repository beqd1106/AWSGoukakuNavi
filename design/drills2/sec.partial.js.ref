// --- qd-sec01 責任共有モデル (10問) ---
add.push(
  q("qd-sec01-e1","security","責任共有モデル",1,
    "「ゲストOS内のアプリケーションのセキュリティパッチ適用」の責任者は誰ですか。",
    ["利用者（アプリ層のパッチ管理）","AWS（基盤側の管理）","データセンター運営会社","回線を提供するISP"],
    "アプリケーション層のパッチ管理は利用者の責任です。",
    ["AWSは基盤側の管理が責任範囲です。","データセンター運営会社は関与しません。","ISPは関与しません。"],
    ["責任共有モデル"],"アプリの中身は利用者、基盤はAWS"),
  q("qd-sec01-e2","security","責任共有モデル",2,
    "Amazon RDSにおける「データベースエンジン自体のパッチ適用」の責任者は誰ですか。",
    ["AWS（マネージド部分の運用）","利用者","第三者ベンダー","利用者の情シス部門"],
    "RDSはマネージド型サービスのため、DBエンジンのパッチ適用はAWSが担います。",
    ["利用者はデータの中身や設定を担当します。","第三者ベンダーは関与しません。","情シス部門はこの作業を行いません。"],
    ["責任共有モデル","マネージドサービス"],"マネージド型はAWSの担当範囲が広い"),
  q("qd-sec01-e3","security","責任共有モデル",2,
    "自社で開発したWebアプリのコードにSQLインジェクションの脆弱性があり侵入されました。主な責任範囲はどちらですか。",
    ["利用者（アプリコードの脆弱性管理）","AWS（基盤の管理）","AWSサポート","ネットワーク機器ベンダー"],
    "アプリケーションコードの脆弱性は利用者の責任範囲です。",
    ["AWSは基盤の管理が責任範囲です。","サポートが代行するものではありません。","ネットワーク機器ベンダーは関与しません。"],
    ["責任共有モデル","シナリオ"],"自作アプリの脆弱性は利用者の責任"),
  q("qd-sec01-e4","security","責任共有モデル",2,
    "AWSが管理するネットワーク機器の不具合でリージョン間の通信に障害が起きました。主な責任範囲はどちらですか。",
    ["AWS（基盤ネットワークの管理）","利用者","利用者の運用チーム","外部CDN事業者"],
    "基盤ネットワーク機器の管理はAWSの責任範囲です。",
    ["利用者はデータ・設定側の管理を担います。","運用チームが基盤機器を管理するわけではありません。","外部CDN事業者は関与しません。"],
    ["責任共有モデル","シナリオ"],"基盤の機器はAWSの責任"),
  q("qd-sec01-e5","security","責任共有モデル",1,
    "次のうち、利用者の責任に含まれないものはどれですか。",
    ["データセンターの入退室管理","IAMユーザーへの権限付与","アプリケーションデータの暗号化選択","セキュリティグループの設定"],
    "データセンターの入退室管理はAWSが担う物理セキュリティです。",
    ["IAMユーザーへの権限付与は利用者の責任です。","暗号化の選択は利用者の責任です。","セキュリティグループの設定は利用者の責任です。"],
    ["責任共有モデル","誤り探し"],"物理施設はAWS、設定は利用者"),
  q("qd-sec01-e6","security","責任共有モデル",1,
    "責任共有モデルは英語で「Shared ＿＿＿＿＿＿ Model」と呼ばれます。＿＿＿＿＿＿に入るのはどれですか。",
    ["Responsibility","Security","Compliance","Ownership"],
    "正式名称はShared Responsibility Modelです。",
    ["Securityという語は含まれません。","Complianceという語は含まれません。","Ownershipという語は含まれません。"],
    ["責任共有モデル","穴埋め"],"Shared Responsibility Model"),
  q("qd-sec01-e7","security","責任共有モデル",2,
    "EC2（IaaS）とS3（マネージド型）を比べたとき、AWSが担う範囲について正しいものはどれですか。",
    ["マネージド型のS3の方がAWSの担う範囲が広い","IaaSのEC2の方がAWSの担う範囲が広い","両者でAWSの範囲は全く同じ","マネージド型では利用者の責任がなくなる"],
    "マネージド型サービスほどAWSが担う運用範囲は広がります。",
    ["IaaSはOS以上を利用者が管理するため範囲は狭くなります。","サービス形態により範囲は異なります。","マネージド型でも設定管理などの責任は残ります。"],
    ["責任共有モデル","サービス比較"],"マネージド型ほどAWSの担当が広い"),
  q("qd-sec01-e8","security","責任共有モデル",1,
    "「利用者が行うデータの分類・アクセス許可の判断」はどちらの責任範囲ですか。",
    ["利用者","AWS","AWSサポート","認定監査法人"],
    "データの分類やアクセス許可の判断は利用者の責任です。",
    ["AWSは基盤側の責任です。","サポートが代行するものではありません。","監査法人は関与しません。"],
    ["責任共有モデル"],"データの扱いは利用者の判断"),
  q("qd-sec01-e9","security","責任共有モデル",2,
    "EC2のセキュリティグループの設定ミスで不要なポートが開放され侵入されました。主な責任範囲はどちらですか。",
    ["利用者（ネットワーク設定の管理）","AWS（基盤の管理）","AWSサポート","ハードウェアベンダー"],
    "セキュリティグループの設定は利用者の責任範囲です。",
    ["AWSは基盤の管理が責任範囲です。","サポートが代行するものではありません。","ハードウェアベンダーは関与しません。"],
    ["責任共有モデル","シナリオ"],"SGの設定ミスは利用者の責任"),
  q("qd-sec01-e10","security","責任共有モデル",2,
    "責任共有モデルの説明として誤っているものはどれですか。",
    ["利用者はデータセンターの物理警備を行う","AWSはハイパーバイザーを管理する","利用者はIAM権限を設定する","境界はサービスの形態により変わる"],
    "データセンターの物理警備はAWSの責任であり、利用者の責任ではありません。",
    ["AWSがハイパーバイザーを管理するのは正しい説明です。","利用者がIAM権限を設定するのは正しい説明です。","境界がサービス形態で変わるのは正しい説明です。"],
    ["責任共有モデル","誤り探し"],"物理警備は常にAWS側"),
);

// --- qd-sec02 IAMの基本 (19問) ---
add.push(
  q("qd-sec02-e1","security","IAM",1,
    "IAMユーザーに直接ポリシーを付与する方法と比べ、グループ経由で付与する利点は何ですか。",
    ["ユーザーが増えても一括で管理しやすい","権限が自動で最小になる","パスワードが不要になる","MFAが自動で有効になる"],
    "グループにポリシーを付与すればメンバー全員へ一括で反映でき、管理が容易になります。",
    ["権限が自動的に最小化されるわけではありません。","パスワードの要否とは無関係です。","MFAが自動で有効になるわけではありません。"],
    ["IAM","グループ"],"共通権限はグループでまとめる"),
  q("qd-sec02-e2","security","IAM",1,
    "IAMロールとIAMユーザーの違いとして正しいものはどれですか。",
    ["ロールは一時的に権限を借り、ユーザーは恒久的なIDを持つ","ロールもユーザーも全く同じ機能である","ユーザーの方が一時的な仕組みである","ロールにはパスワードが必須である"],
    "ロールは一時的に権限を貸し出す仕組みで、ユーザーは恒久的なIDです。",
    ["両者は役割が異なります。","一時的なのはロールの方です。","ロールにパスワードは不要です。"],
    ["IAM","ロール"],"ロール＝一時、ユーザー＝恒久ID"),
  q("qd-sec02-e3","security","IAM",1,
    "複数のAWSサービス間で安全に連携させたいとき、最適な方法はどれですか。",
    ["IAMロールを使い一時的に権限を渡す","アクセスキーをソースコードに埋め込む","ルートユーザーの認証情報を共有する","全サービスに同じパスワードを設定する"],
    "サービス間連携にはIAMロールを使い、鍵を配らずに一時的な権限を渡すのが安全です。",
    ["キー直書きは漏洩リスクがあります。","ルート共有は避けるべきです。","パスワード共有という概念自体が不適切です。"],
    ["IAM","ロール"],"サービス連携はロールが基本"),
  q("qd-sec02-e4","security","IAM",1,
    "「特定のユーザーだけに個別の例外的権限を追加したい」ときに使うのはどれですか。",
    ["ユーザーに直接ポリシーをアタッチする","グループの権限を全体で下げる","ルートユーザーに変更する","アクセスキーを再発行する"],
    "個別の例外対応にはユーザーへ直接ポリシーをアタッチする方法が適しています。",
    ["グループ全体を変更すると他のメンバーにも影響します。","ルートユーザーへの変更は不適切です。","キーの再発行と権限追加は無関係です。"],
    ["IAM","ポリシー"],"個別例外はユーザーへ直接付与"),
  q("qd-sec02-e5","security","IAM",1,
    "IAMポリシーの説明として正しいものはどれですか。",
    ["JSON形式で許可・拒否を記述した文書","ユーザーをまとめる入れ物","一時的な認証情報そのもの","仮想サーバーの設定ファイル"],
    "IAMポリシーはJSON形式で許可・拒否のルールを記述した文書です。",
    ["ユーザーをまとめるのはグループです。","一時的な認証情報はSTSが発行するものです。","仮想サーバーの設定はEC2側の話です。"],
    ["IAM","ポリシー"],"ポリシー＝JSONの許可文書"),
  q("qd-sec02-e6","security","IAM",2,
    "退職した社員のIAMユーザーをそのままにしていました。何が問題ですか。",
    ["不要な認証情報が残りセキュリティリスクになる","課金が二重に発生する","AWSのサポートが停止する","リージョンが変更される"],
    "不要なIAMユーザーを放置すると、悪用され得る認証情報が残りセキュリティリスクとなります。",
    ["課金と直接の関係はありません。","サポート停止とは無関係です。","リージョン変更とは無関係です。"],
    ["IAM","シナリオ"],"退職時はIAMユーザーを削除"),
  q("qd-sec02-e7","security","IAM",1,
    "IAMで複数のユーザーに共通の権限を配る単位を英語で「＿＿＿＿」と呼びます。＿＿＿＿に入るのはどれですか。",
    ["Group","Role","Policy","User"],
    "共通権限をまとめて配る単位はGroup（グループ）です。",
    ["Roleは一時的に権限を借りる仕組みです。","Policyは許可内容の文書です。","Userは個々のIDです。"],
    ["IAM","穴埋め"],"共通配布＝Group"),
  q("qd-sec02-e8","security","IAM",2,
    "IAMの説明として誤っているものはどれですか。",
    ["1つのIAMユーザーは複数のグループに所属できない","ロールは一時的に権限を借りる仕組みである","ポリシーはJSONで記述される","グループにポリシーをアタッチできる"],
    "IAMユーザーは複数のグループに同時に所属できるため、この説明は誤りです。",
    ["ロールが一時的な仕組みなのは正しい説明です。","ポリシーがJSON記述なのは正しい説明です。","グループへのポリシーアタッチは正しい説明です。"],
    ["IAM","誤り探し"],"1ユーザーは複数グループに所属可能"),
  q("qd-sec02-e9","security","IAM",2,
    "開発チームとインフラチームで異なる権限セットを役割ごとに配布したいです。最適な方法はどれですか。",
    ["チームごとにグループを作りポリシーをアタッチする","全員に同一のAdministratorAccessを付与する","チームごとにルートユーザーを発行する","権限設定を省略する"],
    "役割ごとにグループを分けてポリシーを付与すれば、権限を整理して管理できます。",
    ["全員に管理者権限を与えるのは過剰です。","ルートユーザーは複数発行するものではありません。","権限設定の省略はリスクです。"],
    ["IAM","グループ"],"役割ごとにグループを分ける"),
  q("qd-sec02-e10","security","IAM",1,
    "Lambda関数が他のAWSリソースにアクセスするための権限を与える方法はどれですか。",
    ["実行ロール（IAMロール）をアタッチする","IAMユーザーのアクセスキーを埋め込む","ルートユーザーの認証情報を渡す","グループに追加する"],
    "Lambda関数には実行ロールとしてIAMロールをアタッチし、必要な権限を渡します。",
    ["アクセスキーの埋め込みは漏洩リスクがあります。","ルート認証情報の利用は危険です。","Lambda関数をグループに追加する仕組みはありません。"],
    ["IAM","ロール"],"Lambdaには実行ロールを付与"),
  q("qd-sec02-e11","security","IAM",2,
    "IAMグループの制約として正しいものはどれですか。",
    ["グループ自体はアクセス主体にはならず権限配布の入れ物である","グループはEC2にアタッチできる","グループはロールの一種である","グループはアクセスキーを持つ"],
    "グループ自体はリソースへアクセスする主体にはならず、ユーザーへ権限を配るための入れ物です。",
    ["グループをEC2に直接アタッチすることはできません。","グループとロールは別の概念です。","グループはアクセスキーを持ちません。"],
    ["IAM","グループ"],"グループは権限配布の入れ物"),
  q("qd-sec02-e12","security","IAM",1,
    "AWSリソースやユーザーが一時的に借りる権限の仕組みを「IAM＿＿＿」と呼びます。＿＿＿に入るのはどれですか。",
    ["ロール","グループ","ポリシー","キー"],
    "一時的に権限を借りる仕組みはIAMロールです。",
    ["グループは恒久的な権限配布の単位です。","ポリシーは許可内容の文書です。","キーは認証情報です。"],
    ["IAM","穴埋め"],"一時的な権限＝ロール"),
  q("qd-sec02-e13","security","IAM",2,
    "テスト用に一時的な担当者へ数時間だけアクセスを許可したいです。最適な方法はどれですか。",
    ["一時的なロールを引き受けさせる","恒久的なIAMユーザーを新規作成する","ルートユーザーのパスワードを教える","アクセスキーを永久に発行する"],
    "短時間だけの権限付与にはロールを引き受けさせる方法が適しています。",
    ["恒久的なユーザー作成は手間と残存リスクが増えます。","ルートのパスワード共有は危険です。","永久のキー発行は不要なリスクです。"],
    ["IAM","ロール","シナリオ"],"短時間の権限貸与はロールで"),
  q("qd-sec02-e14","security","IAM",2,
    "IAMベストプラクティスとして誤っているものはどれですか。",
    ["全ユーザーのアクセスキーを定期的にローテーションしない","最小権限を意識してポリシーを設計する","グループを使い共通権限をまとめる","不要になったユーザーを削除する"],
    "アクセスキーはローテーションしないと漏洩リスクが高まるため、この説明は誤りです。",
    ["最小権限を意識した設計は正しい実践です。","グループでの共通権限管理は正しい実践です。","不要ユーザーの削除は正しい実践です。"],
    ["IAM","誤り探し"],"キーは定期ローテーションが原則"),
  q("qd-sec02-e15","security","IAM",1,
    "複数の似た権限セットをテンプレート化して使い回したいとき、活用するのはどれですか。",
    ["マネージドポリシーを複数の対象にアタッチする","毎回手書きでインラインポリシーを書く","ルートユーザーの権限をコピーする","アクセスキーを共有する"],
    "マネージドポリシーは複数のユーザーやロールに使い回せる形で管理できます。",
    ["毎回書き直すのは非効率で誤りの元です。","ルート権限のコピーは危険です。","キー共有は不適切です。"],
    ["IAM","ポリシー"],"使い回しはマネージドポリシー"),
  q("qd-sec02-e16","security","IAM",1,
    "アクセスキー（Access Key ID / Secret Access Key）の説明として正しいものはどれですか。",
    ["プログラムやCLIからAWSを操作するための認証情報","コンソールログイン用のパスワード","MFAのワンタイムコード","課金確認用のトークン"],
    "アクセスキーはプログラムやCLIからAWSを操作するための認証情報です。",
    ["コンソールログインにはパスワードを使います。","ワンタイムコードはMFAデバイスが生成します。","課金確認専用のトークンではありません。"],
    ["IAM","アクセスキー"],"アクセスキー＝プログラム用認証情報"),
  q("qd-sec02-e17","security","IAM",2,
    "IAMユーザーのアクセスキーが誤ってGitHubに公開されてしまいました。まず行うべき対応はどれですか。",
    ["該当のアクセスキーを無効化・削除する","放置して様子を見る","パスワードだけ変更する","課金アラートを止める"],
    "漏洩したアクセスキーはただちに無効化・削除して被害拡大を防ぎます。",
    ["放置は被害拡大のリスクがあります。","パスワード変更だけでは鍵漏洩の対処になりません。","課金アラート停止は根本対応になりません。"],
    ["IAM","アクセスキー","シナリオ"],"漏洩キーは即無効化"),
  q("qd-sec02-e18","security","IAM",1,
    "JSON形式で許可・拒否のルールを記述したものを「IAM＿＿＿＿」と呼びます。＿＿＿＿に入るのはどれですか。",
