// --- qd-sec03 IAM（ポリシー・最小権限・MFA・ルートユーザー） (8問) ---
add.push(
  q("qd-sec03-e1","security","IAM",1,
    "特定のS3バケットへの読み取りだけを許可し、他は拒否したいです。使うものはどれですか。",
    ["スコープを絞ったIAMポリシー","AdministratorAccessポリシー","ルートユーザーの認証情報","MFAデバイスの追加"],
    "対象を絞ったIAMポリシーで、必要な読み取り権限だけを許可します。",
    ["管理者権限は過剰で危険です。","ルート利用は日常業務に不適切です。","MFAはアクセス範囲を制御する仕組みではありません。"],
    ["IAM","最小権限"],"必要範囲だけに絞ったポリシーを使う"),
  q("qd-sec03-e2","security","IAM",2,
    "IAMポリシーの評価順序の説明として正しいものはどれですか。",
    ["明示的Denyが最優先、次にAllow、それ以外は暗黙Deny","すべてランダムに評価される","Allowが常にDenyより優先される","評価順序は存在しない"],
    "明示的なDenyが最優先され、次に明示的なAllow、どちらもなければ暗黙のDenyになります。",
    ["評価は決定的な順序で行われます。","明示的DenyはAllowより優先されます。","明確な評価順序が定められています。"],
    ["IAM","ポリシー評価"],"Deny優先→Allow→暗黙Deny"),
  q("qd-sec03-e3","security","IAM",2,
    "新入社員に一時的に管理者権限を渡してしまい、そのまま放置していました。何が問題ですか。",
    ["最小権限の原則に反し不要なリスクが残る","課金が二倍になる","MFAが自動解除される","リージョンが変わる"],
    "不要な広い権限を放置すると最小権限の原則に反し、セキュリティリスクが残ります。",
    ["課金とは直接関係ありません。","MFAの自動解除とは無関係です。","リージョン変更とは無関係です。"],
    ["IAM","最小権限","シナリオ"],"権限は都度見直し絞り込む"),
  q("qd-sec03-e4","security","IAM",1,
    "ルートユーザーの認証情報漏洩を防ぐため、＿＿＿＿を有効化すべきです。＿＿＿＿に入るのはどれですか。",
    ["MFA","VPC","NACL","SCP"],
    "ルートユーザーの保護にはMFA（多要素認証）の有効化が推奨されます。",
    ["VPCはネットワークの仕組みです。","NACLはサブネットの通信制御です。","SCPは組織全体の権限上限設定です。"],
    ["MFA","ルートユーザー","穴埋め"],"ルート保護の基本はMFA"),
  q("qd-sec03-e5","security","IAM",2,
    "最小権限の運用として誤っているものはどれですか。",
    ["全ユーザーに一律で管理者権限を付与し、後で必要に応じて絞る","業務に必要な権限だけを都度見直す","不要になった権限は削除する","一時作業には期限付きロールを使う"],
    "先に広い権限を与えて後から絞る運用は最小権限の原則に反するため誤りです。",
    ["都度の見直しは正しい実践です。","不要権限の削除は正しい実践です。","期限付きロールの利用は正しい実践です。"],
    ["IAM","最小権限","誤り探し"],"広く与えて後で絞るのはNG"),
  q("qd-sec03-e6","security","IAM",2,
    "MFAデバイスを紛失してルートユーザーにログインできなくなりました。どうすべきですか。",
    ["AWSサポート所定の本人確認手続きで復旧する","新しいAWSアカウントを作り直す","放置してログインを諦める","IAMユーザーのパスワードを変更する"],
    "MFAデバイス紛失時はAWSサポートの本人確認手続きを経てアカウントを復旧します。",
    ["アカウントの作り直しは大きな手間と損失を伴います。","放置は業務継続に支障が出ます。","IAMユーザーの変更ではルート復旧になりません。"],
    ["MFA","ルートユーザー","シナリオ"],"MFA紛失時はサポートで復旧"),
  q("qd-sec03-e7","security","IAM",1,
    "同じ権限を持つIAMユーザーが増えても、ポリシー変更を1箇所で済ませたいときに使うのはどれですか。",
    ["IAMグループにポリシーをアタッチする","各ユーザーへ個別にコピーする","ルートユーザーで代行する","アクセスキーを共有する"],
    "グループにポリシーをアタッチすれば、メンバー全員の権限を1箇所で管理できます。",
    ["個別コピーは変更のたびに手間が増えます。","ルートでの代行は不適切です。","キー共有はセキュリティ上不適切です。"],
    ["IAM","グループ"],"共通権限はグループで一元管理"),
  q("qd-sec03-e8","security","IAM",1,
    "ルートユーザーのベストプラクティスとして正しいものはどれですか。",
    ["MFAを有効化し、アクセスキーは作らず日常業務にも使わない","日常業務はすべてルートユーザーで行う","ルートユーザーのパスワードをチーム全員に共有する","ルートユーザーのアクセスキーを複数作成しておく"],
    "ルートユーザーはMFAを有効化し、アクセスキーを作らず日常業務には使わないのが原則です。",
    ["日常業務のルート利用は避けるべきです。","パスワード共有は厳禁です。","ルートのアクセスキー作成は避けるべきです。"],
    ["ルートユーザー","MFA"],"ルートはMFA有効化・日常不使用"),
);

// --- qd-sec04 ルートユーザーの保護とMFA (19問) ---
add.push(
  q("qd-sec04-e1","security","MFA",1,
    "仮想MFAデバイスの例として正しいものはどれですか。",
    ["スマホの認証アプリ（Google Authenticator等）","メールアドレスのみ","ユーザー名のみ","秘密の質問のみ"],
    "仮想MFAデバイスの代表例はスマホの認証アプリです。",
    ["メールアドレスのみでは二つ目の要素になりません。","ユーザー名のみでは認証要素になりません。","秘密の質問のみでは二要素になりません。"],
    ["MFA"],"仮想MFA＝スマホの認証アプリ"),
  q("qd-sec04-e2","security","MFA",2,
    "ルートユーザーのメールアドレスとパスワードだけで運用しており、MFAは未設定です。最優先で行うべきことはどれですか。",
    ["ルートユーザーにMFAを有効化する","パスワードを社内で共有する","アクセスキーを新規発行する","日常業務をルートで行う"],
    "パスワードのみの運用はリスクが高いため、まずMFAを有効化すべきです。",
    ["パスワード共有はリスクを増やします。","ルートのキー発行は避けるべきです。","日常のルート利用は避けるべきです。"],
    ["MFA","ルートユーザー","シナリオ"],"MFA未設定はまず有効化"),
  q("qd-sec04-e3","security","MFA",1,
    "ルートユーザーは通常＿＿＿＿・課金設定変更などの限定的な作業にのみ使うべきです。＿＿＿＿に入るのはどれですか。",
    ["アカウント解約","EC2起動","S3へのファイル保存","IAMユーザーの日常操作"],
    "ルートユーザーはアカウント解約など限定的な作業にのみ使うべきです。",
    ["EC2起動はIAMユーザーで行えます。","S3へのファイル保存はIAMユーザーで行えます。","日常操作はIAMユーザーで行うべきです。"],
    ["ルートユーザー","穴埋め"],"ルート専用作業＝解約等の限定操作"),
  q("qd-sec04-e4","security","MFA",1,
    "ハードウェアMFAデバイスの説明として正しいものはどれですか。",
    ["専用の物理デバイスでワンタイムコードを生成する","スマホアプリのことである","パスワードそのものである","ネットワーク機器である"],
    "ハードウェアMFAデバイスは専用の物理機器でワンタイムコードを生成します。",
    ["スマホアプリは仮想MFAデバイスです。","パスワードとは別の要素です。","ネットワーク機器ではありません。"],
    ["MFA"],"ハードウェアMFA＝専用物理機器"),
  q("qd-sec04-e5","security","MFA",2,
    "ルートユーザー保護の考え方として誤っているものはどれですか。",
    ["ルートユーザーのアクセスキーを複数発行し常用する","MFAを有効化する","日常業務にはIAMユーザーを使う","強固なパスワードを設定する"],
    "ルートのアクセスキーは作らず削除するのが原則で、常用は誤りです。",
    ["MFA有効化は正しい対応です。","日常業務にIAMユーザーを使うのは正しい対応です。","強固なパスワード設定は正しい対応です。"],
    ["ルートユーザー","誤り探し"],"ルートのキーは常用しない"),
  q("qd-sec04-e6","security","MFA",2,
    "複数の管理者でルートユーザーのパスワードを共有して運用しています。何が問題ですか。",
    ["誰が操作したか追跡できず責任の所在が不明になる","課金が高くなる","MFAが自動的に無効化される","IAMユーザーが作成できなくなる"],
    "パスワード共有では操作者を追跡できず、責任の所在が不明になります。",
    ["課金額とは無関係です。","MFAの自動無効化とは無関係です。","IAMユーザー作成とは無関係です。"],
    ["ルートユーザー","シナリオ"],"共有はトレーサビリティを失う"),
  q("qd-sec04-e7","security","MFA",1,
    "ルートユーザーでしかできない操作の例はどれですか。",
    ["AWSアカウント自体の解約","EC2インスタンスの起動","S3バケットの作成","IAMグループの作成"],
    "AWSアカウント自体の解約はルートユーザーでしか行えません。",
    ["EC2起動はIAMユーザーで可能です。","S3バケット作成はIAMユーザーで可能です。","IAMグループ作成はIAMユーザーで可能です。"],
    ["ルートユーザー"],"アカウント解約はルート専用"),
  q("qd-sec04-e8","security","MFA",1,
    "MFAが有効な場合の本人確認の流れとして正しいものはどれですか。",
    ["パスワード入力後、追加でワンタイムコード等を入力する","パスワードのみで完結する","メールアドレスのみで完結する","IPアドレスのみで判定する"],
    "MFA有効時はパスワードに加え、ワンタイムコード等の追加要素で本人確認します。",
    ["パスワードのみではMFAになりません。","メールアドレスのみでは認証要素が不足します。","IPアドレスのみでの判定ではありません。"],
    ["MFA"],"パスワード＋追加要素で確認"),
  q("qd-sec04-e9","security","MFA",1,
    "MFAは＿＿＿＿・所持・生体の要素のうち複数を組み合わせる認証です。＿＿＿＿に入るのはどれですか。",
    ["知識","課金","リージョン","タグ"],
    "MFAは知識・所持・生体のうち複数の要素を組み合わせる認証方式です。",
    ["課金は認証要素ではありません。","リージョンは認証要素ではありません。","タグは認証要素ではありません。"],
    ["MFA","穴埋め"],"MFAの3要素＝知識・所持・生体"),
  q("qd-sec04-e10","security","MFA",2,
    "セキュリティ監査で「ルートユーザーにMFAが設定されていない」と指摘されました。対応はどれですか。",
    ["速やかにルートユーザーへMFAを設定する","指摘を無視する","IAMユーザーのMFAだけ設定する","アカウントを作り直す"],
    "指摘を受けたら速やかにルートユーザーへMFAを設定して是正します。",
    ["指摘の無視はリスクを放置します。","IAMユーザーだけの対応では指摘に応えられません。","アカウント作り直しは過剰な対応です。"],
    ["MFA","シナリオ"],"監査指摘は速やかに是正"),
  q("qd-sec04-e11","security","MFA",2,
    "ルートユーザーとMFAの説明として誤っているものはどれですか。",
    ["MFAを設定すればパスワードは以後不要になる","ルートユーザーは全権限を持つ","MFAは本人確認を強化する仕組みである","ルートの日常利用は避けるべきである"],
    "MFAを設定してもパスワードは引き続き必要なため、この説明は誤りです。",
    ["ルートユーザーが全権限を持つのは正しい説明です。","MFAが本人確認強化なのは正しい説明です。","ルート日常利用回避は正しい説明です。"],
    ["MFA","誤り探し"],"MFAでもパスワードは必要"),
  q("qd-sec04-e12","security","MFA",2,
    "複数人がAWSアカウントの運用に関わる組織で、ルートユーザーへの依存を減らす方法はどれですか。",
    ["権限を絞ったIAMユーザーやロールで業務を行う","ルートのパスワードを共有する","ルートのアクセスキーを配布する","MFAを無効化する"],
    "権限を絞ったIAMユーザーやロールで業務を行うことでルート依存を減らせます。",
    ["パスワード共有は依存とリスクを高めます。","キー配布はリスクを高めます。","MFA無効化はリスクを高めます。"],
    ["ルートユーザー","IAM"],"ルート依存はIAMユーザーで軽減"),
  q("qd-sec04-e13","security","MFA",1,
    "AWSアカウント作成直後の推奨初期対応として正しいものはどれですか。",
    ["ルートユーザーにMFAを設定し、日常用のIAMユーザーを作成する","ルートユーザーのみで運用を続ける","ルートのアクセスキーを発行して使う","パスワードを簡単なものに変更する"],
    "作成直後はルートにMFAを設定し、日常業務用のIAMユーザーを作るのが推奨されます。",
    ["ルートのみでの運用継続はリスクです。","ルートのキー発行は避けるべきです。","パスワードを弱くするのは逆効果です。"],
    ["ルートユーザー","MFA"],"初期対応＝MFA設定＋IAMユーザー作成"),
  q("qd-sec04-e14","security","MFA",2,
    "退職予定の管理者がルートユーザーのパスワードを知っています。退職前に何をすべきですか。",
    ["ルートユーザーのパスワードを変更する","そのまま放置する","IAMユーザーを削除するだけにする","MFAを無効化する"],
    "退職前にはルートユーザーのパスワードを変更し、不正利用を防ぎます。",
    ["放置は不正利用のリスクを残します。","IAMユーザー削除だけではルートの対策になりません。","MFA無効化は逆にリスクを高めます。"],
    ["ルートユーザー","シナリオ"],"退職前はルートのパスワード変更"),
  q("qd-sec04-e15","security","MFA",1,
    "ルートユーザーの保護は「MFA有効化」「＿＿＿＿は作らない」の2点が基本です。＿＿＿＿に入るのはどれですか。",
    ["アクセスキー","IAMユーザー","グループ","ポリシー"],
    "ルート保護の基本は「MFA有効化」と「アクセスキーを作らない」ことです。",
    ["IAMユーザーは通常利用者側で作成するものです。","グループ作成はルート保護と直接関係しません。","ポリシー作成はルート保護と直接関係しません。"],
    ["ルートユーザー","穴埋め"],"ルート保護＝MFA＋キー未作成"),
  q("qd-sec04-e16","security","MFA",1,
    "本人しか持たないスマホでコードを受け取り、なりすましを防ぎたいときに使うのはどれですか。",
    ["MFA（多要素認証）","IAMグループ","アクセスキー","SCP"],
    "スマホでコードを受け取り本人確認を強化する仕組みはMFAです。",
    ["IAMグループは権限をまとめる仕組みです。","アクセスキーは認証情報です。","SCPは組織全体の権限上限設定です。"],
    ["MFA"],"なりすまし対策の基本はMFA"),
  q("qd-sec04-e17","security","MFA",1,
    "ルートユーザーの権限範囲の説明として正しいものはどれですか。",
    ["アカウント内のあらゆる操作が可能な最上位の権限を持つ","IAMユーザーと全く同じ権限しか持たない","課金確認のみに限定される","ネットワーク設定のみに限定される"],
    "ルートユーザーはアカウント内であらゆる操作が可能な最上位の権限を持ちます。",
    ["IAMユーザーは通常より絞られた権限を持ちます。","課金確認のみに限定されません。","ネットワーク設定のみに限定されません。"],
    ["ルートユーザー"],"ルート＝最上位の全権限"),
  q("qd-sec04-e18","security","MFA",2,
    "ルートユーザー運用として誤っているものはどれですか。",
    ["ルートユーザーのMFAは設定しなくてもよい","日常業務はIAMユーザーで行う","ルートのアクセスキーは作らない","強固なパスワードを使う"],
    "ルートユーザーのMFA未設定は推奨事項に反するため誤りです。",
    ["日常業務のIAMユーザー利用は正しい実践です。","キー未作成は正しい実践です。","強固なパスワード利用は正しい実践です。"],
    ["ルートユーザー","誤り探し"],"ルートのMFA未設定はNG"),
  q("qd-sec04-e19","security","MFA",2,
    "スタートアップが最初にAWSアカウントを作りました。ルートユーザーの扱いとして最適なのはどれですか。",
    ["MFAを有効化し、以降の作業用にIAMユーザーを作成して使う","ルートユーザーのままチーム全員で使い続ける","ルートのアクセスキーを発行してCI/CDに使う","パスワードを固定してメモに残す"],
    "MFAを有効化し、以降はIAMユーザーで作業するのが最適な運用です。",
    ["チーム全員でのルート利用は危険です。","ルートのキーをCI/CDに使うのは危険です。","パスワードのメモ保管は漏洩リスクです。"],
    ["ルートユーザー","MFA","シナリオ"],"最初にMFA設定→以後IAMユーザー"),
